#!/usr/bin/env bash
set -euo pipefail

DEFAULT_URL="https://fd.up.railway.app"
WORDLIST_PATH="filedrop-frontend/public/bip39.txt"

usage() {
  cat <<'EOF'
filedrop - end-to-end encrypted, no-account file sharing between machines.
Upload a file, get a one-line download command. Paste that line on any other
box and it fetches the file. No login, files expire on a TTL, encrypted with
AES-256 (server never sees plaintext). Each share is one access code + one
secret word; either alone is useless.

USAGE
  filedrop upload <file> [opts]                upload a file
  filedrop <file> [opts]                       same, shorthand
  filedrop - [opts]                            upload from stdin (pipes work)
  filedrop download <code> <secret> [opts]     fetch a shared file

UPLOAD OPTIONS
  --secret <word>    secret word for the download link (auto-picked if omitted)
  --yes, -y          skip the interactive y/N confirmation (needed for agents/pipes)
  --url <base>       alternate server (default: https://fd.up.railway.app)
  --type <mime>      force MIME type (server stores it as metadata)
  --copy             upload AND copy the `filedrop download <code> <secret>`
                     line to your OS clipboard (needs wl-copy/pbcopy/xclip); the
                     confirm + command echo go to stderr, stdout stays clean unless
                     no clipboard tool is found (then it prints the line).

DOWNLOAD OPTIONS
  --out <path>       where to save (parent dirs are created); omit -> filedrop-<code>.<ext> in cwd
  --url <base>       alternate server (must match the one used for upload)

HOW AN AGENT USES IT
  1. filedrop <file> --yes
     -> stdout:
         Access code: 6e6c
         Secret word: some-word
         Copy-paste to download elsewhere:
           filedrop download 6e6c some-word
  2. Send that whole 2nd command to the receiver (or parse the code+secret).
  3. Receiver runs it: filedrop download 6e6c some-word [--out dest/path]
     -> prints 'Saved to <path>'. Exit 0 on success, non-zero on failure.
  Non-interactive runs (piped stdin, no TTY) skip confirmation automatically.

EXAMPLES
  filedrop ./photo.jpg
  filedrop ./report.pdf --secret myword        # fixed secret, easy to type
  filedrop ./big.bin --yes                      # non-interactive
  echo "hello" | filedrop - --yes               # stdin, temp filename .txt
  filedrop download 6e6c some-word --out ./photo.jpg
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    exit 1
  }
}

normalize_url() {
  echo "${1%/}"
}

pick_secret_word() {
  local explicit="$1"
  if [[ -n "$explicit" ]]; then
    echo "$explicit"
    return
  fi
  if [[ -f "$WORDLIST_PATH" ]]; then
    python3 - <<'PY' "$WORDLIST_PATH"
import random, sys
path = sys.argv[1]
with open(path, 'r', encoding='utf-8') as f:
    words = [w.strip() for w in f.read().splitlines() if w.strip()]
print(random.choice(words) if words else "")
PY
  else
    python3 - <<'PY'
import secrets
print(secrets.token_hex(4))
PY
  fi
}

hex_to_b64() {
  python3 - <<'PY' "$1"
import base64, binascii, sys
data = binascii.unhexlify(sys.argv[1])
print(base64.b64encode(data).decode())
PY
}

b64_to_hex() {
  python3 - <<'PY' "$1"
import base64, binascii, sys
data = base64.b64decode(sys.argv[1])
print(binascii.hexlify(data).decode())
PY
}

derive_key_hex() {
  python3 - <<'PY' "$1" "$2"
import binascii, hashlib, sys
secret = sys.argv[1].encode()
salt = binascii.unhexlify(sys.argv[2])
key = hashlib.pbkdf2_hmac('sha256', secret, salt, 100000, dklen=32)
print(binascii.hexlify(key).decode())
PY
}

detect_mime_type() {
  local file_path="$1"
  if command -v file >/dev/null 2>&1; then
    file --mime-type -b "$file_path" 2>/dev/null || echo "application/octet-stream"
  else
    echo "application/octet-stream"
  fi
}

upload_file() {
  local file_path="$1"
  local secret_word="$2"
  local url="$3"
  local mime_type="$4"
  local copy_only="${5:-0}"

  local salt_hex
  local iv_hex
  salt_hex=$(openssl rand -hex 16)
  iv_hex=$(openssl rand -hex 16)

  local key_hex
  key_hex=$(derive_key_hex "$secret_word" "$salt_hex")

  local tmp_enc
  tmp_enc=$(mktemp)
  openssl enc -aes-256-cbc -K "$key_hex" -iv "$iv_hex" -in "$file_path" -out "$tmp_enc"

  local iv_b64
  local salt_b64
  iv_b64=$(hex_to_b64 "$iv_hex")
  salt_b64=$(hex_to_b64 "$salt_hex")

  local response
  if ! response=$(curl --connect-timeout 10 --max-time 1800 --speed-time 60 --speed-limit 1 -sS -w '\n%{http_code}' \
    -F "file=@${tmp_enc};filename=$(basename "$file_path")" \
    -F "type=${mime_type}" \
    -F "secretWord=${secret_word}" \
    -F "iv=${iv_b64}" \
    -F "salt=${salt_b64}" \
    "${url}/upload"); then
    rm -f "$tmp_enc"
    echo "Upload failed or timed out." >&2
    exit 1
  fi

  rm -f "$tmp_enc"

  local body
  local status
  body="${response%$'\n'*}"
  status="${response##*$'\n'}"
  if [[ "$status" != "200" ]]; then
    echo "Upload failed (${status}): ${body}" >&2
    exit 1
  fi

  python3 - <<'PY' "$body" "$secret_word" "$copy_only"
import json, sys
data = json.loads(sys.argv[1])
key = data.get('key', '')
s = sys.argv[2]
copy_only = sys.argv[3] == '1'
dline = f"filedrop download {key} {s}"
if copy_only:
    print(dline)
else:
    print(f"Access code: {key}")
    print(f"Secret word: {s}")
    print()
    print(f"Copy-paste to download elsewhere:")
    print(f"  {dline}")
PY
}

download_file() {
  local access_code="$1"
  local secret_word="$2"
  local url="$3"
  local out_path="$4"

  local tmp_headers
  local tmp_enc
  tmp_headers=$(mktemp)
  tmp_enc=$(mktemp)

  local status
  if ! status=$(curl --connect-timeout 10 --max-time 1800 --speed-time 60 --speed-limit 1 -sS -o "$tmp_enc" -D "$tmp_headers" -w "%{http_code}" \
    "${url}/retrieve?accessCode=${access_code}&deferConsumption=1"); then
    rm -f "$tmp_headers" "$tmp_enc"
    echo "Download failed or timed out." >&2
    exit 1
  fi

  if [[ "$status" != "200" ]]; then
    echo "Download failed (${status}):" >&2
    cat "$tmp_enc" >&2
    rm -f "$tmp_headers" "$tmp_enc"
    exit 1
  fi

  local iv_b64
  local salt_b64
  local extension
  iv_b64=$(awk -F': ' 'tolower($1)=="x-iv"{print $2}' "$tmp_headers" | tr -d '\r')
  salt_b64=$(awk -F': ' 'tolower($1)=="x-salt"{print $2}' "$tmp_headers" | tr -d '\r')
  extension=$(awk -F': ' 'tolower($1)=="x-extension"{print $2}' "$tmp_headers" | tr -d '\r')
  extension=${extension:-bin}

  if [[ -z "$iv_b64" || -z "$salt_b64" ]]; then
    echo "Missing encryption headers in response." >&2
    rm -f "$tmp_headers" "$tmp_enc"
    exit 1
  fi

  local iv_hex
  local salt_hex
  iv_hex=$(b64_to_hex "$iv_b64")
  salt_hex=$(b64_to_hex "$salt_b64")

  local key_hex
  key_hex=$(derive_key_hex "$secret_word" "$salt_hex")

  local final_path="$out_path"
  if [[ -z "$final_path" ]]; then
    final_path="filedrop-${access_code}.${extension}"
  fi
  mkdir -p "$(dirname -- "$final_path")"

  if ! openssl enc -d -aes-256-cbc -K "$key_hex" -iv "$iv_hex" -in "$tmp_enc" -out "$final_path"; then
    rm -f "$tmp_headers" "$tmp_enc" "$final_path"
    echo "Unable to decrypt this file. Check that the access code and secret word match." >&2
    exit 1
  fi

  curl --connect-timeout 5 --max-time 15 -fsS -X POST "${url}/confirm-retrieval?accessCode=${access_code}" >/dev/null || \
    echo "Warning: downloaded successfully, but the server could not update the download count." >&2

  rm -f "$tmp_headers" "$tmp_enc"
  echo "Saved to ${final_path}"
}

main() {
  require_cmd openssl
  require_cmd curl
  require_cmd python3

  if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
  fi

  local cmd="$1"
  shift || true

  # upload is an explicit verb (symmetric with download); everything else is a file path.
  if [[ "$cmd" == "upload" ]]; then
    if [[ $# -lt 1 ]]; then
      usage
      exit 1
    fi
    file_path="$1"
    shift
  else
    file_path="$cmd"
  fi

  if [[ "$cmd" == "download" || "$cmd" == "get" ]]; then
    if [[ $# -lt 2 ]]; then
      usage
      exit 1
    fi
    local access_code="$1"
    local secret_word="$2"
    shift 2
    local out_path=""
    local url="$DEFAULT_URL"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --out)
          out_path="$2"
          shift 2
          ;;
        --url)
          url="$2"
          shift 2
          ;;
        *)
          echo "Unknown option: $1" >&2
          exit 1
          ;;
      esac
    done
    download_file "$access_code" "$secret_word" "$(normalize_url "$url")" "$out_path"
    exit 0
  fi

  :
  if [[ "$file_path" == "-" ]]; then
    file_path=$(mktemp --suffix=.txt)
    cat > "$file_path"
  fi
  if [[ ! -f "$file_path" ]]; then
    echo "File not found: $file_path" >&2
    exit 1
  fi

  local secret_word=""
  local url="$DEFAULT_URL"
  local mime_type=""
  local assume_yes=0
  local copy_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --secret)
        secret_word="$2"
        shift 2
        ;;
      --url)
        url="$2"
        shift 2
        ;;
      --type)
        mime_type="$2"
        shift 2
        ;;
      --yes|-y)
        assume_yes=1
        shift
        ;;
      --copy)
        copy_only=1
        shift
        ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  secret_word=$(pick_secret_word "$secret_word")
  if [[ -z "$secret_word" ]]; then
    echo "Unable to determine secret word." >&2
    exit 1
  fi
  if [[ -z "$mime_type" ]]; then
    mime_type=$(detect_mime_type "$file_path")
  fi

  # Confirm before uploading (skipped for -y or non-interactive/agent runs).
  if [[ "$assume_yes" -eq 0 && -t 0 ]]; then
    local confirm=""
    read -r -p "Upload $(basename "$file_path") ($(du -h "$file_path" | cut -f1)) to $(normalize_url "$url")? [y/N] " confirm || confirm=""
    case "$confirm" in
      y|Y|yes|Yes|YES) ;;
      *) echo "Aborted." >&2; exit 1 ;;
    esac
  fi

  local clipboard
  if [[ "$copy_only" -eq 1 ]]; then
    local dline
    dline=$(upload_file "$file_path" "$secret_word" "$(normalize_url "$url")" "$mime_type" "$copy_only")
    if command -v wl-copy >/dev/null 2>&1; then
      clipboard=wl-copy
    elif command -v pbcopy >/dev/null 2>&1; then
      clipboard=pbcopy
    elif command -v xclip >/dev/null 2>&1; then
      clipboard=xclip -selection clipboard
    elif command -v xsel >/dev/null 2>&1; then
      clipboard="xsel --clipboard --input"
    fi
    if [[ -n "$clipboard" ]]; then
      if [[ "$clipboard" == xclip* ]]; then
        printf '%s' "$dline" | xclip -selection clipboard
      elif [[ "$clipboard" == xsel* ]]; then
        printf '%s' "$dline" | xsel --clipboard --input
      else
        "$clipboard" < <(printf '%s' "$dline")
      fi
      echo "Copied to clipboard: $dline" >&2
    else
      # no clipboard tool — fall back to printing so it can be copied by hand
      printf '%s\n' "$dline"
    fi
  else
    upload_file "$file_path" "$secret_word" "$(normalize_url "$url")" "$mime_type" "$copy_only"
  fi
  if [[ "$cmd" == "-" || "$cmd" == "upload" ]]; then
    rm -f "$file_path"
  fi
}

main "$@"
